spring.application.name=auth-service
server.port=${SERVER_PORT:8081}

# Copy to application.properties and fill Neon credentials.
# Must share the same JWT secret as CRM (crm.security.jwt.secret).

spring.datasource.url=${DB_URL:jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=disable&prepareThreshold=0}
spring.datasource.username=${DB_USER:neondb_owner}
spring.datasource.password=${DB_PASSWORD:YOUR_NEON_PASSWORD}

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.table=auth_flyway_schema_history
spring.flyway.baseline-on-migrate=true
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true

# Shared JWT secret with CRM (Base64, >= 256 bits after decode)
auth.security.jwt.secret=${JWT_SECRET:Y3JtLWp3dC1zZWNyZXQtaW5zYS1lcnAtcGhhc2UtMS1rZXktMjAyNg==}
auth.security.jwt.expiration-ms=${JWT_EXPIRATION_MS:900000}
auth.security.jwt.refresh-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:604800000}

# Shared Redis JWT blacklist (set REDIS_BLACKLIST_ENABLED=false if Redis is unavailable)
auth.security.redis-blacklist.enabled=${REDIS_BLACKLIST_ENABLED:true}
auth.security.redis-blacklist.fail-closed=${REDIS_BLACKLIST_FAIL_CLOSED:true}
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}

# CORS (comma-separated; avoid *)
auth.cors.allowed-origins=${AUTH_CORS_ORIGINS:http://localhost:3000,http://localhost:5173}

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always
info.app.name=auth-service
info.app.description=INSA ERP shared Auth Service
info.app.version=0.0.1-SNAPSHOT
