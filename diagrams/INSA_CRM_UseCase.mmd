graph LR
    %% INSA CRM System - Use Case Diagram with Campaign Management
    %% Created for Mermaid rendering
    
    classDef actor fill:#ffeb3b,stroke:#333,stroke-width:2px
    classDef usecase fill:#90caf9,stroke:#1976d2,stroke-width:2px
    classDef system fill:#e3f2fd,stroke:#1976d2,stroke-width:3px
    classDef campaign fill:#f8bbd0,stroke:#c2185b,stroke-width:2px
    
    %% Actors
    Visitor[Public Visitor]:::actor
    Customer[Customer]:::actor
    SalesOfficer[Sales Officer]:::actor
    SalesManager[Sales Manager]:::actor
    Marketing[Marketing Manager]:::actor
    Finance[Finance Officer]:::actor
    Auditor[Auditor]:::actor
    Admin[Admin]:::actor
    
    %% Public Portal
    subgraph PublicPortal[Public Portal]
        UC1[Submit Lead Inquiry]:::usecase
        UC2[View Products Catalog]:::usecase
        UC3[Submit Contact Form]:::usecase
        UC4[Subscribe Newsletter]:::usecase
    end
    
    %% Authentication
    subgraph Auth[Authentication]
        UCLogin[Login to System]:::usecase
        UCValidate[Validate Credentials]:::usecase
        UCToken[Generate JWT Token]:::usecase
    end
    
