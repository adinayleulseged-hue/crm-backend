@startuml INSA_CRM_Complete_Use_Cases

!define RECTANGLE
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor Black
}

title INSA CRM System - Complete Use Case Diagram with Campaign Management

left to right direction

' ========================================
' ACTORS
' ========================================
actor "Public Visitor" as Visitor #LightGreen
actor "Customer" as Customer #LightYellow
actor "Sales Officer" as SalesOfficer #LightCyan
actor "Sales Manager" as SalesManager #LightCoral
actor "Marketing Manager" as Marketing #Pink
actor "Finance Officer" as Finance #Gold
actor "Auditor" as Auditor #LightGray
actor "Admin" as Admin #Red
actor "Email System" as EmailSystem #White

' ========================================
' SYSTEM BOUNDARY
' ========================================
rectangle "INSA CRM System" #AliceBlue {
  
  ' ========================================
  ' PUBLIC PORTAL USE CASES
  ' ========================================
  package "Public Portal" #LightGreen {
    usecase "Submit Lead Inquiry\n(UC1)" as UC1 #PaleGreen
    usecase "View Products Catalog\n(UC2)" as UC2 #PaleGreen
    usecase "Submit Contact Form\n(UC3)" as UC3 #PaleGreen
    usecase "Subscribe to Newsletter\n(UC4)" as UC4 #PaleGreen
  }

  ' ========================================
  ' AUTHENTICATION (CORE)
  ' ========================================
  package "Authentication" #LightCoral {
    usecase "Login to System\n(UC_Login)" as UC_Login #MistyRose
    usecase "Validate Credentials\n(UC_ValidateCreds)" as UC_ValidateCreds #MistyRose
    usecase "Generate JWT Token\n(UC_GenerateToken)" as UC_GenerateToken #MistyRose
    usecase "Logout from System\n(UC_Logout)" as UC_Logout #MistyRose
  }

  ' ========================================
  ' CUSTOMER PORTAL
  ' ========================================
  package "Customer Portal" #LightYellow {
    usecase "View Own Orders\n(UC10)" as UC10 #LemonChiffon
    usecase "Track Order Status\n(UC11)" as UC11 #LemonChiffon
    usecase "View Own Invoices\n(UC12)" as UC12 #LemonChiffon
    usecase "Make Payment\n(UC13)" as UC13 #LemonChiffon
    usecase "Download Invoice PDF\n(UC14)" as UC14 #LemonChiffon
    usecase "Submit Sales Inquiry\n(UC15)" as UC15 #LemonChiffon
    usecase "View Products\n(UC16)" as UC16 #LemonChiffon
    usecase "Chat with Support\n(UC17)" as UC17 #LemonChiffon
    usecase "View Order History\n(UC18)" as UC18 #LemonChiffon
  }

  ' ========================================
  ' LEAD MANAGEMENT
  ' ========================================
  package "Lead Management" #LightCyan {
    usecase "View All Leads\n(UC20)" as UC20 #PaleTurquoise
    usecase "Create New Lead\n(UC21)" as UC21 #PaleTurquoise
    usecase "Edit Lead\n(UC22E)" as UC22E #PaleTurquoise
    usecase "Qualify Lead\n(UC22)" as UC22 #PaleTurquoise
    usecase "Disqualify Lead\n(UC23)" as UC23 #PaleTurquoise
    usecase "Provide Qualification Reason\n(UC24)" as UC24 #Aquamarine
    usecase "Provide Disqualification Reason\n(UC25)" as UC25 #Aquamarine
    usecase "Convert Lead to Customer\n(UC26)" as UC26 #PaleTurquoise
    usecase "Assign Lead to Rep\n(UC27)" as UC27 #PaleTurquoise
    usecase "Send Notification Email\n(UC_EmailNotif)" as UC_EmailNotif #LightBlue
  }

  ' ========================================
  ' CAMPAIGN MANAGEMENT (NEW!)
  ' ========================================
  package "Campaign Management" #Pink {
    usecase "View All Campaigns\n(UC80)" as UC80 #LightPink
    usecase "Create Campaign\n(UC81)" as UC81 #LightPink
    usecase "Edit Campaign\n(UC82)" as UC82 #LightPink
    usecase "Launch Campaign\n(UC83)" as UC83 #LightPink
    usecase "Pause Campaign\n(UC84)" as UC84 #LightPink
    usecase "Close Campaign\n(UC85)" as UC85 #LightPink
    usecase "Define Target Audience\n(UC86)" as UC86 #HotPink
    usecase "Set Campaign Budget\n(UC87)" as UC87 #HotPink
    usecase "Schedule Campaign\n(UC88)" as UC88 #HotPink
    usecase "Track Campaign Performance\n(UC89)" as UC89 #LightPink
    usecase "Generate Campaign Report\n(UC90)" as UC90 #LightPink
    usecase "Send Bulk Email\n(UC91)" as UC91 #HotPink
    usecase "Track Email Opens\n(UC92)" as UC92 #HotPink
    usecase "Track Click Rates\n(UC93)" as UC93 #HotPink
    usecase "Assign Leads to Campaign\n(UC94)" as UC94 #LightPink
  }

  ' ========================================
  ' SALES & OPPORTUNITY MANAGEMENT
  ' ========================================
  package "Sales Management" #Coral {
    usecase "View Sales Deals\n(UC30)" as UC30 #LightCoral
    usecase "Create Sales Deal\n(UC31)" as UC31 #LightCoral
    usecase "Edit Sales Deal\n(UC32)" as UC32 #LightCoral
    usecase "Approve Sales Deal\n(UC33)" as UC33 #LightCoral
    usecase "Reject Sales Deal\n(UC34)" as UC34 #LightCoral
    usecase "Apply Discount\n(UC35)" as UC35 #Salmon
    usecase "Generate Quotation\n(UC36)" as UC36 #Salmon
    usecase "Validate Deal Amount\n(UC_ValidateAmount)" as UC_ValidateAmount #Salmon
    usecase "Track Deal Progress\n(UC37)" as UC37 #LightCoral
  }

  ' ========================================
  ' CUSTOMER MANAGEMENT
  ' ========================================
  package "Customer Management" #Wheat {
    usecase "View Customers\n(UC40)" as UC40 #Khaki
    usecase "Create Customer\n(UC41)" as UC41 #Khaki
    usecase "Invite Customer\n(UC42)" as UC42 #Khaki
    usecase "Generate Temp Password\n(UC43)" as UC43 #BurlyWood
    usecase "Send Invitation Email\n(UC44)" as UC44 #BurlyWood
    usecase "Edit Customer Info\n(UC45)" as UC45 #Khaki
    usecase "Delete Customer\n(UC46)" as UC46 #Khaki
  }

  ' ========================================
  ' FINANCIAL MANAGEMENT
  ' ========================================
  package "Financial Management" #Gold {
    usecase "View Invoices\n(UC50)" as UC50 #LightGoldenrodYellow
    usecase "Create Invoice\n(UC51)" as UC51 #LightGoldenrodYellow
    usecase "Approve Invoice\n(UC52)" as UC52 #LightGoldenrodYellow
    usecase "Process Payment\n(UC53)" as UC53 #LightGoldenrodYellow
    usecase "View Payment History\n(UC54)" as UC54 #LightGoldenrodYellow
    usecase "Generate Financial Report\n(UC55)" as UC55 #LightGoldenrodYellow
    usecase "Validate Payment Method\n(UC_ValidatePayment)" as UC_ValidatePayment #Goldenrod
    usecase "Send Payment Receipt\n(UC56)" as UC56 #Goldenrod
    usecase "Reconcile Accounts\n(UC57)" as UC57 #LightGoldenrodYellow
  }

  ' ========================================
  ' SYSTEM ADMINISTRATION
  ' ========================================
  package "Administration" #Tomato {
    usecase "Manage Users\n(UC60)" as UC60 #LightSalmon
    usecase "Create User Account\n(UC61)" as UC61 #LightSalmon
    usecase "Auto-Generate Password\n(UC62)" as UC62 #DarkSalmon
    usecase "Send User Credentials\n(UC63)" as UC63 #DarkSalmon
    usecase "Change User Role\n(UC64)" as UC64 #LightSalmon
    usecase "Delete User\n(UC65)" as UC65 #LightSalmon
    usecase "View Audit Logs\n(UC66)" as UC66 #LightSalmon
    usecase "View System Status\n(UC67)" as UC67 #LightSalmon
  }

  ' ========================================
  ' AUDIT & COMPLIANCE
  ' ========================================
  package "Audit & Compliance" #Silver {
    usecase "View All System Logs\n(UC70)" as UC70 #Gainsboro
    usecase "View User Activities\n(UC71)" as UC71 #Gainsboro
    usecase "Generate Audit Report\n(UC72)" as UC72 #Gainsboro
    usecase "Export Audit Data\n(UC73)" as UC73 #Gainsboro
    usecase "Monitor System Health\n(UC74)" as UC74 #DarkGray
  }
}

