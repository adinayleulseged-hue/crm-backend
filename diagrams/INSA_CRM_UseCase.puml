' ========================================
' <<INCLUDE>> RELATIONSHIPS (MANDATORY)
' ========================================

' Authentication always required
UC10 .up.> UC_Login : <<include>>
UC20 .up.> UC_Login : <<include>>
UC30 .up.> UC_Login : <<include>>
UC40 .up.> UC_Login : <<include>>
UC50 .up.> UC_Login : <<include>>
UC60 .up.> UC_Login : <<include>>
UC70 .up.> UC_Login : <<include>>
UC80 .up.> UC_Login : <<include>>

' Login process steps
UC_Login .right.> UC_ValidateCreds : <<include>>
UC_ValidateCreds .right.> UC_GenerateToken : <<include>>

' Lead qualification always sends email
UC22 ..> UC_EmailNotif : <<include>>
UC23 ..> UC_EmailNotif : <<include>>

' User creation always generates password
UC61 ..> UC62 : <<include>>
UC61 ..> UC63 : <<include>>

' Customer invitation always includes
UC42 ..> UC43 : <<include>>
UC42 ..> UC44 : <<include>>

' Payment always validates
UC53 ..> UC_ValidatePayment : <<include>>

' Deal approval/rejection always notifies
UC33 ..> UC_EmailNotif : <<include>>
UC34 ..> UC_EmailNotif : <<include>>

' Campaign creation always defines audience
UC81 ..> UC86 : <<include>>

' Campaign launch always sends emails
UC83 ..> UC91 : <<include>>

